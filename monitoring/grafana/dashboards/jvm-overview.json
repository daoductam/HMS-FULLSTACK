          "legendFormat": "{{service}} - Used",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "jvm_memory_max_bytes{area=\"heap\", service=~\"$service\"}",
